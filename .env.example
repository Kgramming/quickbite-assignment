# FastAPI Configuration
API_HOST=127.0.0.1
API_PORT=8002
LOG_LEVEL=info

# Database Configuration
DATABASE_URL=postgresql+psycopg://quickbite_user:quickbite_password@127.0.0.1:5434/quickbite_db
DATABASE_ECHO=false

# RabbitMQ Configuration
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=quickbite
RABBITMQ_PASSWORD=quickbite_password
RABBITMQ_VHOST=/

# Application
ENVIRONMENT=development
DEBUG=false
